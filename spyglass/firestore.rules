rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Sign-up gating ────────────────────────────────────────────────
    // Google sign-in itself can't be blocked (Firebase Auth creates the
    // account), so the gate lives at the DATA layer: every read/write to a
    // user's subtree requires an /allowedUsers/{uid} doc to exist. When
    // /config/app.signupsOpen is true, a new user may create their own
    // allowedUsers doc on first login (the app does this automatically);
    // when false, only the admin can add one. The Cloudflare Worker uses
    // the Admin service account and bypasses these rules entirely.

    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == 'HWXl8ZWQ4qPybl3kZmm6PoUHdHE3';
    }

    function isAllowed(uid) {
      return exists(/databases/$(database)/documents/allowedUsers/$(uid));
    }

    // Global app config — anyone signed-in may read (the app needs
    // signupsOpen to explain a closed door); only the admin may write.
    match /config/app {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Membership keys. A user may read their own; self-service create is
    // permitted only while signupsOpen is true; the admin can manage all.
    match /allowedUsers/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        get(/databases/$(database)/documents/config/app).data.signupsOpen == true
      );
      allow update, delete: if isAdmin();
    }

    // A signed-in, allowed user owns everything under their own subtree.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
                         && isAllowed(userId);

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId
                           && isAllowed(userId);
      }
    }
  }
}
