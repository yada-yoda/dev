# Per-project ignores live in this single file
acting/source/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
node_modules/
dist/
__pycache__/
*.pyc

# Cloudflare Wrangler local cache (should never be committed)
oauth-worker/.wrangler/

# Reel master export - only the web-compressed copy is committed
acting/assets/reel/*.mp4
!acting/assets/reel/frank-rizzo-reel.mp4
